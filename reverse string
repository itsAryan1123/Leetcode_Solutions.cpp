class Solution {
public:
    void reverseString(vector<char>& s) {
        int left = 0;                  // Pointer at the start
        int right = s.size() - 1;      // Pointer at the end
        
        while (left < right) {
            // Swap the characters at left and right positions
            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;
            
            // Move pointers towards the middle
            left++;
            right--;
        }
    }
};
